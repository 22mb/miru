// Dependency updates, replacing .github/dependabot.yml. JSONC (not JSON5) because the
// Renovate docs recommend it for commented config, and the reasoning belongs next to
// the settings the way the dependabot file kept it.
//
// Bun needs no manager entry: Renovate's `bun` manager claims bun.lock and the
// package.json files itself, and stands in for the npm manager. As with dependabot,
// this file covers *version* updates only — disclosed CVEs surface through GitHub's
// security alerts (repo Settings -> Security), not through here.
//
// Watch the first update that touches a workspace package (packages/*/package.json)
// rather than the root: Renovate has had recurring reports of bun.lock not being
// regenerated in that case, which lands as a `bun install --frozen-lockfile` failure
// in CI. If that happens, the lockfile is missing from the PR — not a real dep break.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // GitHub Actions are pinned to a commit SHA with a trailing `# vX.Y.Z` comment
    // (supply-chain safety). This preset sets pinDigests for the github-actions
    // manager, so anything added later unpinned gets pinned too.
    "helpers:pinGitHubActionDigests"
  ],
  // Weekly, matching the cadence dependabot ran at. A handful of dev dependencies and
  // three runtime ones don't justify anything more frequent.
  "schedule": ["before 6am on monday"],
  // Dependabot moved the package.json range along with the lockfile. Renovate's default
  // (`auto`) resolves to `update-lockfile` for this ecosystem, which leaves `^0.58.0`
  // alone when 0.59.0 lands because the range already covers it — the manifest would
  // drift from what's installed. `bump` keeps the manifest honest.
  "rangeStrategy": "bump",
  // Don't propose a version until it has been public for three days. Hijacked npm
  // releases are typically caught and unpublished within hours, so a short wait clears
  // most of that exposure — and it matters more here than usual, because non-major
  // updates below are set to merge without anyone reading them. Security updates
  // deliberately bypass this. Renovate holds pending versions on the Dependency
  // Dashboard rather than opening a PR (internalChecksFilter defaults to strict).
  //
  // This only covers what Renovate itself bumps. The same window is set for Bun in
  // bunfig.toml, which is what applies when the lockfile gets regenerated — including
  // transitive dependencies, which Renovate does not manage.
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      // One PR a week for everything that isn't a major — including the GitHub Action
      // digest bumps, which move the SHA and its `# vX.Y.Z` comment together. Majors
      // stay on their own so they get read rather than skimmed as part of a batch.
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major",
      // Merged without a human once the four required checks pass. `platformAutomerge`
      // (on by default) hands this to GitHub's own auto-merge, so the branch ruleset
      // still gates it: the checks must pass, and the approval it also requires has to
      // be waived for Renovate via a bypass actor, or nothing will ever merge itself.
      "automerge": true
    }
  ]
}
